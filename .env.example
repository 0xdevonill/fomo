# Public site config — add the same keys in Vercel → Settings → Environment Variables,
# then Redeploy. NEXT_PUBLIC_ values are baked in at build time.

# Main token. After you create the token, paste its contract here and Redeploy.
# Name, ticker, on-chain logo, USD price, and market stats load from
# DexScreener / GeckoTerminal automatically.
NEXT_PUBLIC_TOKEN_CONTRACT=0x1Ad69dDD9D98dD71b6211339A1801fD128A3925D
NEXT_PUBLIC_TOKEN_CONTRACT_SOL=

# Optional overrides. Leave empty so the contract’s name / ticker / logo win.
NEXT_PUBLIC_TOKEN_SYMBOL=
NEXT_PUBLIC_TOKEN_NAME=
NEXT_PUBLIC_TOKEN_LOGO=

# Social + launchpad
NEXT_PUBLIC_X_URL=https://x.com/helixliquidity
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/helixliquidity
NEXT_PUBLIC_PONS_URL=
NEXT_PUBLIC_PONS_ID=

# Short blurb shown on the token page and in the site description
NEXT_PUBLIC_TOKEN_INFO=
